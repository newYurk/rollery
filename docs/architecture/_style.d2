# Общий стиль атласа. Импортируется каждым листом строкой `...@_style`.
#
# Палитра — та же, что у docs/reports/kinematics.html и у страницы атласа:
# у проекта уже есть свой вид отчётов, и заводить второй значило бы, что доки
# перестали быть одним изданием. Первая редакция листов была светлой («бумага
# на тёмном столе») — владелец 01.09 сказала, что это читается разнобоем,
# и листы перекрашены в ту же основу, что страница.
#
# Правило цвета одно и оно жёсткое: КРАСНЫЙ ЗНАЧИТ «ЭТО МЕШАЕТ ПЕРЕЕЗДУ».
# Не «плохой код», не «страшно», а именно: пока связь красная, шаг миграции
# на листе 4 сделать нельзя. Всё остальное — серое, золотое и зелёное — фон.

vars: {
  d2-config: {
    layout-engine: elk
    # 200 — тёмная тема d2. Нужна не ради узлов (их красят классы ниже), а ради
    # СЛУЖЕБНОЙ графики, до которой классы не дотягиваются: линии жизни и рамки
    # групп в sequence-диаграмме листа 3 берут цвет у темы, и на светлой они
    # оставались белыми полосами посреди тёмного листа.
    theme-id: 200
    pad: 40
  }
}

# Фон самого листа. Без этой строки d2 рисует прозрачный SVG, и лист берёт
# цвет того, во что вставлен: на странице был бы тёмным, а открытый отдельным
# файлом в браузере — белым. Лист обязан выглядеть одинаково везде.
style: {
  fill: "#15171a"
}

classes: {
  # ── зоны (контейнеры) ──────────────────────────────────────────────
  zone: {
    style: {
      stroke: "#3b434b"
      fill: "#1b1e22"
      font-color: "#e9e6dd"
      stroke-width: 2
      border-radius: 10
    }
  }
  # зона, которой в рантайме нет (лаборатория, оффлайн-инструменты)
  zone-off: {
    style: {
      stroke: "#3b434b"
      fill: "#191c1f"
      font-color: "#a6a396"
      stroke-width: 2
      stroke-dash: 4
      border-radius: 10
    }
  }

  # ── узлы ───────────────────────────────────────────────────────────
  file: {
    style: {
      stroke: "#3f474f"
      fill: "#23272c"
      font-color: "#e9e6dd"
      stroke-width: 1
      border-radius: 4
    }
  }
  # глобал, живущий в общем лексическом окружении classic-скриптов
  glob: {
    style: {
      stroke: "#e2765c"
      fill: "#2b1a17"
      font-color: "#f2b6a4"
      stroke-width: 3
      bold: true
      border-radius: 4
    }
  }
  # состояние в браузере, переживающее перезагрузку
  store: {
    shape: cylinder
    style: {
      stroke: "#3f474f"
      fill: "#23272c"
      font-color: "#e9e6dd"
    }
  }
  # то, к чему едем
  target: {
    style: {
      stroke: "#79c48b"
      fill: "#17251e"
      font-color: "#bfe3c9"
      stroke-width: 2
      border-radius: 6
    }
  }
  # предусловие / сторож
  guard: {
    style: {
      stroke: "#e8b74e"
      fill: "#26200f"
      font-color: "#efd193"
      stroke-width: 2
      border-radius: 6
    }
  }
  note: {
    shape: text
    style: {
      font-color: "#a6a396"
      font-size: 14
    }
  }
  head: {
    shape: text
    style: {
      font-color: "#e9e6dd"
      font-size: 22
      bold: true
    }
  }

  # ── рёбра ──────────────────────────────────────────────────────────
  bad: {
    style: {
      stroke: "#e2765c"
      stroke-width: 3
      bold: true
      font-color: "#f2b6a4"
    }
  }
  ok: {
    style: {
      stroke: "#7b8189"
      stroke-width: 2
      font-color: "#a6a396"
    }
  }
  faint: {
    style: {
      stroke: "#565e66"
      stroke-width: 1
      stroke-dash: 4
      font-color: "#8b8880"
    }
  }
  good: {
    style: {
      stroke: "#79c48b"
      stroke-width: 3
      font-color: "#bfe3c9"
    }
  }
}
